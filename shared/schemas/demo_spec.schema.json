{
  "$defs": {
    "AppStateEqualsAssertion": {
      "additionalProperties": false,
      "properties": {
        "expected_value": {
          "$ref": "#/$defs/JsonValue"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "key": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$",
          "title": "Key",
          "type": "string"
        },
        "type": {
          "const": "app_state_equals",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "key",
        "expected_value"
      ],
      "title": "AppStateEqualsAssertion",
      "type": "object"
    },
    "ClickAction": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "target": {
          "discriminator": {
            "mapping": {
              "css": "#/$defs/CssTarget",
              "label": "#/$defs/LabelTarget",
              "role": "#/$defs/RoleTarget",
              "test_id": "#/$defs/TestIdTarget",
              "text": "#/$defs/TextTarget"
            },
            "propertyName": "strategy"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/RoleTarget"
            },
            {
              "$ref": "#/$defs/LabelTarget"
            },
            {
              "$ref": "#/$defs/TextTarget"
            },
            {
              "$ref": "#/$defs/TestIdTarget"
            },
            {
              "$ref": "#/$defs/CssTarget"
            }
          ],
          "title": "Target"
        },
        "timeout_ms": {
          "default": 10000,
          "maximum": 120000,
          "minimum": 1,
          "title": "Timeout Ms",
          "type": "integer"
        },
        "type": {
          "const": "click",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "target"
      ],
      "title": "ClickAction",
      "type": "object"
    },
    "CssTarget": {
      "additionalProperties": false,
