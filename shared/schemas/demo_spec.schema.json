    "FillAction": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "target": {
          "discriminator": {
            "mapping": {
              "css": "#/$defs/CssTarget",
              "label": "#/$defs/LabelTarget",
              "role": "#/$defs/RoleTarget",
              "test_id": "#/$defs/TestIdTarget",
              "text": "#/$defs/TextTarget"
            },
            "propertyName": "strategy"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/RoleTarget"
            },
            {
              "$ref": "#/$defs/LabelTarget"
            },
            {
              "$ref": "#/$defs/TextTarget"
            },
            {
              "$ref": "#/$defs/TestIdTarget"
            },
            {
              "$ref": "#/$defs/CssTarget"
            }
          ],
          "title": "Target"
        },
        "timeout_ms": {
          "default": 10000,
          "maximum": 120000,
          "minimum": 1,
          "title": "Timeout Ms",
          "type": "integer"
        },
        "type": {
          "const": "fill",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "description": "Non-sensitive demonstration data; never a credential or secret.",
          "maxLength": 10000,
          "title": "Value",
          "type": "string"
