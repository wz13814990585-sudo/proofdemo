      ],
      "title": "TextTarget",
      "type": "object"
    },
    "UrlEqualsAssertion": {
      "additionalProperties": false,
      "properties": {
        "expected_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Expected Url",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
