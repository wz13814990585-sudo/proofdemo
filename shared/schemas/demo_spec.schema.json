        "selector": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Selector",
          "type": "string"
        },
        "strategy": {
          "const": "css",
          "title": "Strategy",
          "type": "string"
        }
      },
      "required": [
        "strategy",
        "selector"
      ],
      "title": "CssTarget",
      "type": "object"
    },
