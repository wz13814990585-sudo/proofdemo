    "GotoAction": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "timeout_ms": {
          "default": 30000,
          "maximum": 120000,
          "minimum": 1,
          "title": "Timeout Ms",
          "type": "integer"
        },
        "type": {
          "const": "goto",
          "title": "Type",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
