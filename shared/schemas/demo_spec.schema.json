    "TextTarget": {
      "additionalProperties": false,
      "properties": {
        "exact": {
          "default": true,
          "title": "Exact",
          "type": "boolean"
        },
        "strategy": {
          "const": "text",
          "title": "Strategy",
          "type": "string"
        },
        "text": {
          "maxLength": 500,
          "minLength": 1,
