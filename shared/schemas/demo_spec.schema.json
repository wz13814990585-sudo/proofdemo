    "JsonValue": {},
    "LabelTarget": {
      "additionalProperties": false,
      "properties": {
        "exact": {
          "default": true,
          "title": "Exact",
          "type": "boolean"
        },
        "label": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "strategy": {
          "const": "label",
          "title": "Strategy",
          "type": "string"
        }
      },
      "required": [
        "strategy",
        "label"
      ],
      "title": "LabelTarget",
      "type": "object"
    },
    "PauseAction": {
      "additionalProperties": false,
      "description": "A presentation delay, not a page-readiness primitive.",
      "properties": {
        "duration_ms": {
          "maximum": 30000,
          "minimum": 1,
          "title": "Duration Ms",
          "type": "integer"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "pause",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "duration_ms"
      ],
      "title": "PauseAction",
      "type": "object"
    },
    "RoleTarget": {
      "additionalProperties": false,
      "properties": {
        "exact": {
          "default": true,
          "title": "Exact",
          "type": "boolean"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "role": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "strategy": {
          "const": "role",
          "title": "Strategy",
          "type": "string"
        }
      },
      "required": [
        "strategy",
        "role"
      ],
      "title": "RoleTarget",
      "type": "object"
    },
    "Scene": {
      "additionalProperties": false,
      "description": "An ordered story beat. Assertion execution starts in Stage 2.",
      "properties": {
        "actions": {
          "items": {
            "discriminator": {
              "mapping": {
                "click": "#/$defs/ClickAction",
                "fill": "#/$defs/FillAction",
                "goto": "#/$defs/GotoAction",
                "pause": "#/$defs/PauseAction",
                "screenshot": "#/$defs/ScreenshotAction"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/GotoAction"
              },
              {
                "$ref": "#/$defs/ClickAction"
              },
              {
                "$ref": "#/$defs/FillAction"
              },
              {
                "$ref": "#/$defs/PauseAction"
              },
              {
                "$ref": "#/$defs/ScreenshotAction"
              }
            ]
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Actions",
          "type": "array"
        },
        "assertions": {
          "items": {
            "discriminator": {
              "mapping": {
                "app_state_equals": "#/$defs/AppStateEqualsAssertion",
                "download_completed": "#/$defs/DownloadCompletedAssertion",
                "element_visible": "#/$defs/ElementVisibleAssertion",
                "text_contains": "#/$defs/TextContainsAssertion",
                "url_equals": "#/$defs/UrlEqualsAssertion"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ElementVisibleAssertion"
              },
              {
                "$ref": "#/$defs/UrlEqualsAssertion"
              },
              {
                "$ref": "#/$defs/TextContainsAssertion"
              },
              {
                "$ref": "#/$defs/DownloadCompletedAssertion"
              },
              {
                "$ref": "#/$defs/AppStateEqualsAssertion"
              }
            ]
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Assertions",
          "type": "array"
        },
        "goal": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Goal",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "goal",
        "actions",
        "assertions"
      ],
      "title": "Scene",
      "type": "object"
    },
    "ScreenshotAction": {
      "additionalProperties": false,
      "properties": {
        "full_page": {
          "default": false,
          "title": "Full Page",
          "type": "boolean"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,99}$",
          "title": "Name",
          "type": "string"
