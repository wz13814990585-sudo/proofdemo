{
  "schema_version": "1.2",
  "id": "todo_demo",
  "title": "Create a task",
  "goal": "Show a product user creating a new task and seeing it in the list.",
  "source_url": "http://127.0.0.1:4173/",
  "audience": "Product evaluation team",
  "language": "en",
  "approximate_duration_seconds": 30,
  "scenes": [
    {
      "id": "create_task",
      "title": "Create the task",
      "goal": "Add a task named Prepare launch demo.",
      "actions": [
        {
          "id": "open-todo-app",
          "type": "goto",
          "url": "http://127.0.0.1:4173/"
        },
        {
          "id": "enter-task-title",
          "type": "fill",
          "target": {
            "strategy": "label",
            "label": "Task title"
          },
          "value": "Prepare launch demo"
        },
        {
          "id": "add-task",
          "type": "click",
          "target": {
            "strategy": "role",
            "role": "button",
            "name": "Add task"
          }
        },
        {
          "id": "download-launch-plan",
          "type": "click",
          "target": {
            "strategy": "role",
            "role": "link",
            "name": "Download launch plan"
          }
        },
        {
          "id": "capture-created-task",
          "type": "screenshot",
          "name": "task-created"
        }
      ],
      "assertions": [
        {
          "id": "task-is-listed",
          "type": "text_contains",
          "target": {
            "strategy": "test_id",
            "test_id": "task-list"
          },
          "expected_text": "Prepare launch demo"
        },
        {
          "id": "task-list-visible",
          "type": "element_visible",
          "target": {
            "strategy": "test_id",
            "test_id": "task-list"
          }
        },
        {
          "id": "todo-url-remains",
          "type": "url_equals",
          "expected_url": "http://127.0.0.1:4173/"
        },
        {
          "id": "launch-plan-downloaded",
          "type": "download_completed",
          "filename": "launch-plan.txt"
        },
        {
          "id": "task-count-updated",
          "type": "app_state_equals",
          "key": "taskCount",
          "expected_value": 1
        }
      ]
    }
  ]
}
