# Backend
PROOFDEMO_ENVIRONMENT=development
PROOFDEMO_API_HOST=127.0.0.1
PROOFDEMO_API_PORT=8000
PROOFDEMO_FRONTEND_ORIGIN=http://127.0.0.1:5173
PROOFDEMO_JOB_ROOT=artifacts/jobs

# Production requires an HTTPS frontend origin. Keep provider keys in the
# process environment rather than a deployed .env file.

# Planner provider: openai (default) or deepseek. Choose a supported model explicitly.
PROOFDEMO_PLANNER_PROVIDER=openai
PROOFDEMO_OPENAI_MODEL=
PROOFDEMO_DEEPSEEK_MODEL=
# Set DEEPSEEK_API_KEY only in the local process environment, never in a committed file.
PROOFDEMO_OPENAI_TTS_MODEL=
PROOFDEMO_OPENAI_TTS_VOICE=
OPENAI_API_KEY=
